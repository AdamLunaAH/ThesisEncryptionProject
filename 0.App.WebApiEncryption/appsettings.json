{
    "Logging": {
        "LogLevel": {
            "Default": "Warning",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",

    "ApplicationSecrets": {
        "SecretStorage": "UserSecrets", // available options: "UserSecrets", "AzureKeyVault"
        "UserSecretsAssembly": "App.WebApiEncryption"
    },

    "DatabaseConnections": {
        "DefaultDataUser": "dbo", //"gstusr" | "usr" | "supusr" | "dbo" | "root"
        "MigrationUser": "root", //migration is done by root user
        "UseDataSetWithTag": "sql-encryption.postgresql.docker" // .postgresql.azure | .postgresql.docker
    },

    "WebApi": [
        {
            "Name": "",
            "BaseUri": ""
        },
        {
            "Name": "",
            "BaseUri": ""
        }
    ],
    "Chat": {
        "HubUrl": "https://localhost:7258/benchmarkhub"
    },
    "BenchmarkPayload": {
        "StorageRoot": "benchmark-payloads"
    }
}






